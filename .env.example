# Model. Default: Claude (set ANTHROPIC_API_KEY or run `ant auth login`)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Claude only; leave blank for models without effort support
LLM_EFFORT=low

# ...or any OpenAI-compatible API (see README, "Use any model")
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Optional URL reputation checks (skipped when blank)
GOOGLE_SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=

# Twilio (SMS replies/alerts are logged instead of sent when blank)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
VALIDATE_TWILIO_SIGNATURE=true

# Guardian links, protected:guardian pairs in E.164
GUARDIANS=+15551230001:+15551230002
GUARDIAN_ALERT_THRESHOLD=0.8
